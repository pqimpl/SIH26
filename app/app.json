{
  "expo": {
    "name": "Sudhi",
    "slug": "sudhi",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "sudhi",
    "userInterfaceStyle": "automatic",
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0A4145",
          "image": "./assets/images/splash-brand.png",
          "resizeMode": "contain"
        }
      ],
      "expo-font",
      [
        "expo-image-picker",
        {
          "photosPermission": "Sudhi uses your photos to set a profile picture."
        }
      ],
      [
        "expo-audio",
        {
          "microphonePermission": "Sudhi uses your microphone so you can talk to it out loud."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
