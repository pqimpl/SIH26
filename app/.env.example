EXPO_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Sudhi voice assistant — Sarvam AI (speech-to-text + text-to-speech)
# Get a key at https://dashboard.sarvam.ai
EXPO_PUBLIC_SARVAM_API_KEY=your-sarvam-api-key

# Sudhi voice assistant — Google Gemini (generates the spoken reply)
# Get a key at https://aistudio.google.com/apikey
EXPO_PUBLIC_LLM_API_KEY=your-gemini-api-key
EXPO_PUBLIC_LLM_API_URL=https://generativelanguage.googleapis.com/v1beta/models
# Free-tier daily request quotas vary a lot between models — gemini-3.6-flash
# allows only 20/day, which runs out quickly during a demo.
EXPO_PUBLIC_LLM_MODEL=gemini-3.5-flash-lite
